<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- 品牌标记作为每页固定头图：三页文案变化，视觉锚点保持一致 -->
        <ImageView
            android:id="@+id/onboard_mark"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_onboard_shield" />

        <TextView
            android:id="@+id/onboard_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.3"
            android:textColor="@color/qs_accent"
            android:textSize="@dimen/qs_text_status" />

        <TextView
            android:id="@+id/onboard_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/qs_text"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onboard_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="7dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/qs_text_muted"
            android:textSize="@dimen/qs_text_body" />

    </LinearLayout>
</ScrollView>
