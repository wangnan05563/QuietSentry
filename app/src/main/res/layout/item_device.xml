<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.QuietSentry.DeviceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/qs_space_16"
    android:background="@drawable/comp_shape_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/qs_space_12">

    <!-- 封面 = 最近快照缩略图（T04046），拉取失败或离线从未拍到时回退设备名首字 -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/device_thumb"
            android:layout_width="@dimen/qs_size_icon"
            android:layout_height="@dimen/qs_size_icon"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- 用 minWidth/minHeight 而不是固定 56dp：系统字号放大后固定尺寸会让首字母被裁掉 -->
        <TextView
            android:id="@+id/device_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/qs_idle"
            android:gravity="center"
            android:minWidth="56dp"
            android:minHeight="56dp"
            android:paddingStart="@dimen/qs_space_8"
            android:paddingEnd="@dimen/qs_space_8"
            android:textColor="@color/qs_text"
            android:textSize="@dimen/qs_text_title" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/qs_space_12"
        android:paddingEnd="@dimen/qs_space_8">

        <TextView
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/qs_text"
            android:textSize="@dimen/qs_text_body" />

        <TextView
            android:id="@+id/device_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_2"
            android:textColor="@color/qs_text_muted"
            android:textSize="@dimen/qs_text_caption" />

        <TextView
            android:id="@+id/device_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_6"
            android:textColor="@color/qs_inline_text_70"
            android:textSize="@dimen/qs_text_caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/device_state_dot"
            android:layout_width="@dimen/qs_size_dot"
            android:layout_height="@dimen/qs_size_dot"
            android:layout_marginEnd="@dimen/qs_space_6"
            android:background="@drawable/comp_shape_dot" />

        <TextView
            android:id="@+id/device_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/qs_text_status" />
    </LinearLayout>
</LinearLayout>
