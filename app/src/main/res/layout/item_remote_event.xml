<?xml version="1.0" encoding="utf-8"?>
<!--
  大屏事件侧栏的行（T04058）：类型 + 时间一行放完，远端事件暂无回放入口，
  行不响应点击，也没有选中态——只做时间线呈现。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/qs_space_8"
    android:paddingTop="@dimen/qs_space_6"
    android:paddingEnd="@dimen/qs_space_8"
    android:paddingBottom="@dimen/qs_space_6">

    <TextView
        android:id="@+id/side_event_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/qs_text"
        android:textSize="@dimen/qs_text_status" />

    <TextView
        android:id="@+id/side_event_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qs_space_2"
        android:textColor="@color/qs_text_muted"
        android:textSize="@dimen/qs_text_caption" />
</LinearLayout>
