<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/qs_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pairing_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pairing_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/pairing_title"
                android:textColor="@android:color/white"
                android:textSize="@dimen/qs_text_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/pairing_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_12"
            android:textColor="@color/qs_text_muted"
            android:textSize="@dimen/qs_text_status" />

        <!-- 二维码本身带白底黑码，不加背景色填充，避免留白比例失真影响识别 -->
        <ImageView
            android:id="@+id/pairing_qr"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/qs_space_16"
            android:contentDescription="@string/pairing_qr_desc" />

        <TextView
            android:id="@+id/pairing_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_12"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="@dimen/qs_text_headline" />

        <TextView
            android:id="@+id/pairing_fingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_4"
            android:gravity="center"
            android:textColor="@color/qs_text_muted"
            android:textSize="@dimen/qs_text_caption" />

        <Button
            android:id="@+id/pairing_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_16"
            android:text="@string/pairing_refresh" />

        <Button
            android:id="@+id/pairing_invite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:text="@string/pairing_invite" />

        <Button
            android:id="@+id/pairing_invite_guest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:text="@string/pairing_invite_guest" />

        <TextView
            android:id="@+id/pairing_devices_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_24"
            android:text="@string/pairing_devices_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/qs_text_body" />

        <LinearLayout
            android:id="@+id/pairing_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/pairing_devices_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pairing_devices_empty"
            android:textColor="@color/qs_text_muted"
            android:textSize="@dimen/qs_text_status" />

        <Button
            android:id="@+id/pairing_recovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_16"
            android:text="@string/pairing_recovery" />

        <Button
            android:id="@+id/pairing_revoke_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:text="@string/pairing_revoke_all" />
    </LinearLayout>
</ScrollView>
