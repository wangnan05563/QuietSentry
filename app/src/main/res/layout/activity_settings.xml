<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qs_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/settings_title"
                android:textColor="@color/qs_text"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_alert"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_quiet_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_quiet_switch"
            android:textColor="@color/qs_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings_quiet_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/settings_quiet_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_quiet_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_plan"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_plan_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_plan_switch"
            android:textColor="@color/qs_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings_plan_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/settings_plan_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_plan_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_level"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/settings_level_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/settings_level_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_level_all"
                android:textColor="@color/qs_text" />

            <RadioButton
                android:id="@+id/settings_level_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_level_normal"
                android:textColor="@color/qs_text" />

            <RadioButton
                android:id="@+id/settings_level_urgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_level_urgent"
                android:textColor="@color/qs_text" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_level_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_privacy"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_pin_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_pin_switch"
            android:textColor="@color/qs_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settings_pin_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_pin_change" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_pin_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/settings_mask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_mask_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/settings_audit_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_audit_open" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_audit_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_integration"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_integration_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_integration_switch"
            android:textColor="@color/qs_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/settings_integration_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_integration_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/settings_integration_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/qs_text_muted"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settings_integration_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_integration_token" />

        <Button
            android:id="@+id/settings_integration_disable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_integration_disable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_power"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <!-- T04033：仅充电时值守此前只有默认值、无 UI 开关，用户改不了也看不到当前取值 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_charge_only_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_charge_only_switch"
            android:textColor="@color/qs_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_charge_only_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <!-- 黑屏拍照震动反馈（T04023）：黑屏无快门动画，震动是唯一确认，但允许关闭 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_shutter_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_shutter_switch"
            android:textColor="@color/qs_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_shutter_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <!-- 音量键快门（T04034）：与系统音量互斥，开启后黑屏页内音量键不再调音量 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_volume_shutter_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_volume_shutter_switch"
            android:textColor="@color/qs_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_volume_shutter_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_health"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/settings_diag_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_diag_run" />

        <TextView
            android:id="@+id/settings_diag_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/qs_text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/settings_diag_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/settings_diag_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_diag_export" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_update"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/settings_update_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/qs_text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settings_update_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_update_check" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_update_hint"
            android:textColor="@color/qs_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_start"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/settings_quick_steps"
            android:textColor="@color/qs_text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settings_quick_pairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_quick_pairing" />

        <Button
            android:id="@+id/settings_quick_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_quick_devices" />
    </LinearLayout>
</ScrollView>
