<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qs_bg">

    <ImageView
        android:id="@+id/live_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/live_frame_desc"
        android:scaleType="fitCenter" />

    <!-- 与 live_image 同尺寸同 fitCenter 公式，框才能落在画面内的正确位置（T04053） -->
    <com.quietsentry.app.PersonBoxOverlay
        android:id="@+id/live_person_boxes"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/live_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/qs_space_24"
        android:textColor="@color/qs_text_muted"
        android:textSize="@dimen/qs_text_status" />

    <LinearLayout
        android:id="@+id/live_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/qs_overlay"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/qs_space_8">

        <Button
            android:id="@+id/live_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_close" />

        <TextView
            android:id="@+id/live_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/qs_text"
            android:textSize="@dimen/qs_text_body" />

        <TextView
            android:id="@+id/live_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/qs_text_muted"
            android:textSize="@dimen/qs_text_status" />
    </LinearLayout>

    <!-- 远程动作竖排（PRD 4.3）：对讲/警笛/手电是画面在演时的“插话”动作，
         放右侧不遮挡底部状态条；仍用文字按钮——项目不引图标库，文字比自带 emoji 图标更可预期 -->
    <LinearLayout
        android:id="@+id/live_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/qs_space_8">

        <Button
            android:id="@+id/live_talk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_talk" />

        <Button
            android:id="@+id/live_siren"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:text="@string/live_siren" />

        <Button
            android:id="@+id/live_torch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:text="@string/live_torch" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/qs_overlay"
        android:orientation="vertical"
        android:padding="@dimen/qs_space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <!-- 画质三档单选（PRD 4.3）：半透明胶囊替代原两档 toggle；
             选中态交给 android:selected + selector，Activity 只负责切换 selected 与重连 -->
        <LinearLayout
            android:id="@+id/live_quality_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/qs_space_8"
            android:layout_weight="2"
            android:background="@color/qs_overlay"
            android:orientation="horizontal"
            android:padding="@dimen/qs_space_2">

            <TextView
                android:id="@+id/live_quality_auto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/live_quality_pill_item"
                android:gravity="center"
                android:paddingTop="@dimen/qs_space_8"
                android:paddingBottom="@dimen/qs_space_8"
                android:text="@string/live_quality_auto"
                android:textColor="@color/live_quality_pill_text"
                android:textSize="@dimen/qs_text_status" />

            <TextView
                android:id="@+id/live_quality_smooth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/live_quality_pill_item"
                android:gravity="center"
                android:paddingTop="@dimen/qs_space_8"
                android:paddingBottom="@dimen/qs_space_8"
                android:text="@string/live_quality_smooth"
                android:textColor="@color/live_quality_pill_text"
                android:textSize="@dimen/qs_text_status" />

            <TextView
                android:id="@+id/live_quality_hd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/live_quality_pill_item"
                android:gravity="center"
                android:paddingTop="@dimen/qs_space_8"
                android:paddingBottom="@dimen/qs_space_8"
                android:text="@string/live_quality_hd"
                android:textColor="@color/live_quality_pill_text"
                android:textSize="@dimen/qs_text_status" />
        </LinearLayout>

            <Button
                android:id="@+id/live_snapshot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/qs_space_8"
                android:layout_weight="1"
                android:text="@string/live_snapshot" />

            <Button
                android:id="@+id/live_pause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_pause" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
