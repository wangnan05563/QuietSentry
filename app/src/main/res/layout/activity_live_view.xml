<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qs_bg">

    <ImageView
        android:id="@+id/live_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/live_frame_desc"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/live_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/qs_text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/live_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/qs_overlay"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/live_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_close" />

        <TextView
            android:id="@+id/live_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/qs_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/live_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/qs_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/qs_overlay"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 六个按钮排成两行：单行在竖屏手机上会把每个按钮压到不足 55dp，点不中 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/live_talk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/live_talk" />

            <Button
                android:id="@+id/live_siren"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/live_siren" />

            <Button
                android:id="@+id/live_torch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_torch" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <!-- 画质三档单选（PRD 4.3）：半透明胶囊替代原两档 toggle；
             选中态交给 android:selected + selector，Activity 只负责切换 selected 与重连 -->
        <LinearLayout
            android:id="@+id/live_quality_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="2"
            android:background="@color/qs_overlay"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/live_quality_auto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/live_quality_pill_item"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/live_quality_auto"
                android:textColor="@color/live_quality_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/live_quality_smooth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/live_quality_pill_item"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/live_quality_smooth"
                android:textColor="@color/live_quality_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/live_quality_hd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/live_quality_pill_item"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/live_quality_hd"
                android:textColor="@color/live_quality_pill_text"
                android:textSize="14sp" />
        </LinearLayout>

            <Button
                android:id="@+id/live_snapshot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/live_snapshot" />

            <Button
                android:id="@+id/live_pause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_pause" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
