<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/qs_space_24">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/qs_text_muted"
        android:textSize="@dimen/qs_text_status" />

    <ViewFlipper
        android:id="@+id/consent_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/qs_space_24">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/consent_page1_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/qs_text_title_large"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qs_space_16"
                    android:lineSpacingExtra="@dimen/qs_space_6"
                    android:text="@string/consent_page1_body"
                    android:textColor="@color/qs_inline_text_87"
                    android:textSize="@dimen/qs_text_body" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/consent_page2_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/qs_text_title_large"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qs_space_16"
                    android:lineSpacingExtra="@dimen/qs_space_6"
                    android:text="@string/consent_page2_body"
                    android:textColor="@color/qs_inline_text_87"
                    android:textSize="@dimen/qs_text_body" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/consent_page3_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/qs_text_title_large"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qs_space_16"
                    android:lineSpacingExtra="@dimen/qs_space_6"
                    android:text="@string/consent_page3_body"
                    android:textColor="@color/qs_inline_text_87"
                    android:textSize="@dimen/qs_text_body" />
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <TextView
        android:id="@+id/consent_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qs_space_16"
        android:gravity="center"
        android:textColor="@color/qs_text_hint"
        android:textSize="@dimen/qs_text_caption" />

    <CheckBox
        android:id="@+id/consent_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qs_space_8"
        android:text="@string/consent_checkbox"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <Button
        android:id="@+id/consent_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qs_space_12"
        android:text="@string/consent_next" />

</LinearLayout>
