<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- PRD 3.3：权限缺失时顶部阻断色横幅，默认隐藏，授予后即收起。
         T04889：走 Widget.QuietSentry.ErrorBanner 样式（comp_banner_bg + qs_space_12），
         与 timeline 撤销条 / 实时页断流横幅同源；保留 PRD 3.3 单横幅原则（一个可点击 TextView，无多按钮） -->
    <TextView
        android:id="@+id/banner_permission"
        style="@style/Widget.QuietSentry.ErrorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center"
        android:text="@string/banner_notification_permission"
        android:textColor="@color/qs_text"
        android:textSize="@dimen/qs_text_status"
        android:visibility="gone" />

    <!-- 入口收敛：高频动作（开始/停止值守）保留实体按钮，其余七入口进“更多”，
         给预览画面留出最大可视面积，底部只留状态与最近事件 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/qs_overlay"
        android:orientation="vertical"
        android:padding="@dimen/qs_space_12">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="@dimen/qs_text_status" />

        <TextView
            android:id="@+id/recent_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:background="@color/qs_inline_scrim_20"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="1"
            android:padding="@dimen/qs_space_10"
            android:textColor="@android:color/white"
            android:textSize="@dimen/qs_text_status"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:orientation="horizontal">

            <Button
                android:id="@+id/primary_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start_guard" />

            <Button
                android:id="@+id/more_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/qs_space_8"
                android:text="@string/more_menu" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
