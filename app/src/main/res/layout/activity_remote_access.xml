<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qs_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/qs_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/remote_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.QuietSentry.SecondaryButton"
                android:text="@string/remote_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/remote_title"
                android:textColor="@color/qs_text"
                android:textSize="@dimen/qs_text_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/remote_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_12"
            android:textColor="@color/qs_text_muted"
            android:textSize="@dimen/qs_text_status" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_20"
            android:text="@string/remote_target_label"
            android:textColor="@color/qs_text"
            android:textSize="@dimen/qs_text_body" />

        <EditText
            android:id="@+id/remote_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_6"
            android:hint="@string/remote_target_hint"
            android:inputType="textNoSuggestions"
            android:textColor="@color/qs_text"
            android:textColorHint="@color/qs_text_hint" />

        <Button
            android:id="@+id/remote_probe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            style="@style/Widget.QuietSentry.PrimaryButton"
            android:text="@string/remote_probe" />

        <TextView
            android:id="@+id/remote_lan_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_12"
            android:textColor="@color/qs_idle"
            android:textSize="@dimen/qs_text_status" />

        <TextView
            android:id="@+id/remote_overlay_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_6"
            android:textColor="@color/qs_idle"
            android:textSize="@dimen/qs_text_status" />

        <TextView
            android:id="@+id/remote_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_12"
            android:textColor="@color/qs_text"
            android:textSize="@dimen/qs_text_body" />

        <Button
            android:id="@+id/remote_wifi_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_16"
            style="@style/Widget.QuietSentry.SecondaryButton"
            android:text="@string/remote_wifi_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_24"
            android:text="@string/remote_guide_title"
            android:textColor="@color/qs_text"
            android:textSize="@dimen/qs_text_body" />

        <TextView
            android:id="@+id/remote_guide_tailscale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_8"
            android:lineSpacingExtra="@dimen/qs_space_4"
            android:text="@string/remote_guide_tailscale"
            android:textColor="@color/qs_inline_text_80"
            android:textSize="@dimen/qs_text_status" />

        <TextView
            android:id="@+id/remote_guide_wireguard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_16"
            android:lineSpacingExtra="@dimen/qs_space_4"
            android:text="@string/remote_guide_wireguard"
            android:textColor="@color/qs_inline_text_80"
            android:textSize="@dimen/qs_text_status" />

        <TextView
            android:id="@+id/remote_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qs_space_20"
            android:text="@string/remote_fallback"
            android:textColor="@color/qs_text_muted"
            android:textSize="@dimen/qs_text_status" />
    </LinearLayout>
</ScrollView>
