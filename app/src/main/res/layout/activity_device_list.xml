<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/qs_space_12">

        <Button
            android:id="@+id/device_list_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timeline_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/device_list_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/qs_text_subtitle" />

        <Button
            android:id="@+id/device_list_add"
            style="@style/Widget.QuietSentry.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_list_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/device_list_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/qs_space_12"
        android:paddingEnd="@dimen/qs_space_12"
        android:paddingBottom="@dimen/qs_space_8"
        android:text="@string/device_list_hint"
        android:textColor="@color/qs_text_muted"
        android:textSize="@dimen/qs_text_caption" />

    <!-- 全部离线时的分流提示（PRD 07 §4.2）：与“从未添加”空态区分开，
         有设备在线时该条就是噪音，由代码控制显隐 -->
    <LinearLayout
        android:id="@+id/device_list_offline_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/qs_inline_warn_15"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/qs_space_12"
        android:paddingEnd="@dimen/qs_space_12"
        android:paddingTop="@dimen/qs_space_8"
        android:paddingBottom="@dimen/qs_space_8"
        android:visibility="gone">

        <TextView
            android:id="@+id/device_list_offline_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/qs_space_8"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/device_offline_banner"
            android:textColor="@color/qs_inline_warn"
            android:textSize="@dimen/qs_text_status" />

        <Button
            android:id="@+id/device_list_rescan"
            style="@style/Widget.QuietSentry.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_offline_rescan"
            android:textSize="@dimen/qs_text_caption" />

        <Button
            android:id="@+id/device_list_diag"
            style="@style/Widget.QuietSentry.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_offline_diag"
            android:textSize="@dimen/qs_text_caption" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- T04742：顶部下拉触发一次立即轮询，不必等 5 秒周期（docs/07 §4.3）。
             三档布局共用同一 id，手势逻辑只在 DeviceListActivity 写一份 -->
        <com.quietsentry.app.PullToRefreshScrollView
            android:id="@+id/device_list_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/device_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/qs_space_12" />
        </com.quietsentry.app.PullToRefreshScrollView>

        <!-- 从未添加的空态（PRD 07 §4.2）：三步说明 + 三条配对路径全部可见
             （扫码主按钮 / 配对码 / 手动 IP），不让用户先理解“添加”是个流程 -->
        <LinearLayout
            android:id="@+id/device_list_empty_box"
            style="@style/Widget.QuietSentry.EmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/qs_space_32"
            android:visibility="gone">

            <TextView
                android:id="@+id/device_list_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/device_list_empty"
                android:textColor="@color/qs_text_muted"
                android:textSize="@dimen/qs_text_status" />

            <Button
                android:id="@+id/device_empty_scan"
                style="@style/Widget.QuietSentry.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qs_space_16"
                android:text="@string/scan_pair_title" />

            <Button
                android:id="@+id/device_empty_code"
                style="@style/Widget.QuietSentry.SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qs_space_8"
                android:text="@string/device_empty_code" />

            <Button
                android:id="@+id/device_empty_manual"
                style="@style/Widget.QuietSentry.SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qs_space_8"
                android:text="@string/device_empty_manual" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
