<?xml version="1.0" encoding="utf-8"?>
<!--
  宽屏双栏（PRD §12.3）：左侧设备列表，右侧实时画面。
  sw600dp 覆盖平板竖屏/横屏与折叠屏展开态；手机无论横竖屏都落在默认单栏布局，
  因为手机横屏的最小宽度仍在 400dp 上下，硬塞两栏会让两侧都挤到读不清。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/qs_space_12">

        <Button
            android:id="@+id/device_list_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timeline_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/device_list_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/qs_text_subtitle" />

        <Button
            android:id="@+id/device_list_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_list_add" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏固定 300dp：列表再宽也只是把卡片拉长，加宽反而让右侧画面变小 -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/device_list_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/qs_space_12"
                android:paddingEnd="@dimen/qs_space_12"
                android:paddingBottom="@dimen/qs_space_8"
                android:text="@string/device_list_hint"
                android:textColor="@color/qs_text_muted"
                android:textSize="@dimen/qs_text_caption" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.quietsentry.app.PullToRefreshScrollView
                    android:id="@+id/device_list_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/device_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/qs_space_12" />
                </com.quietsentry.app.PullToRefreshScrollView>

                <TextView
                    android:id="@+id/device_list_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="@dimen/qs_space_24"
                    android:text="@string/device_list_empty"
                    android:textColor="@color/qs_text_muted"
                    android:textSize="@dimen/qs_text_status"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/qs_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/qs_space_12"
                android:paddingEnd="@dimen/qs_space_8"
                android:paddingTop="@dimen/qs_space_8">

                <TextView
                    android:id="@+id/device_preview_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/qs_text"
                    android:textSize="@dimen/qs_text_body" />

                <Button
                    android:id="@+id/device_preview_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_preview_full" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/device_preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/live_frame_desc"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/device_preview_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/qs_space_24"
                    android:text="@string/device_preview_hint"
                    android:textColor="@color/qs_text_muted"
                    android:textSize="@dimen/qs_text_status" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
