<?xml version="1.0" encoding="utf-8"?>
<!--
  ≥840dp 三栏（PRD 4.7，T04058）：左侧设备列表、中间画面、右侧可收起的事件流。
  折叠屏展开态与平板横屏落在这里；折叠（<840dp）时系统换回 sw600dp 双栏布局，
  Activity 是否重建由 manifest 的 configChanges + 代码判断断点跨越决定，布局资源随 recreate 生效。
  画面区用 fitCenter + 黑底：容器随三栏分宽，画面内容始终按原始比例居中，不会被拉伸变形（16:9 保持）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/device_list_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timeline_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/device_list_title"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/device_list_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_list_add" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏固定 300dp：与 sw600dp 双栏同宽，断点跨越时左栏视觉不变 -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/device_list_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="@string/device_list_hint"
                android:textColor="@color/qs_text_muted"
                android:textSize="@dimen/qs_text_caption" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/device_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp" />
                </ScrollView>

                <TextView
                    android:id="@+id/device_list_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/device_list_empty"
                    android:textColor="@color/qs_text_muted"
                    android:textSize="@dimen/qs_text_status"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/qs_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/device_preview_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/qs_text"
                    android:textSize="@dimen/qs_text_body" />

                <Button
                    android:id="@+id/device_side_expand"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/device_side_expand"
                    android:textColor="@color/qs_text_muted"
                    android:textSize="@dimen/qs_text_status"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/device_preview_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_preview_full" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/device_preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/live_frame_desc"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/device_preview_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/device_preview_hint"
                    android:textColor="@color/qs_text_muted"
                    android:textSize="@dimen/qs_text_status" />
            </FrameLayout>
        </LinearLayout>

        <!-- 右侧事件侧栏：固定 280dp，收起只藏这一栏，画面与列表不被顶动 -->
        <LinearLayout
            android:id="@+id/device_side_bar"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="@color/qs_surface"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/device_side_title"
                    android:textColor="@color/qs_text"
                    android:textSize="@dimen/qs_text_status" />

                <Button
                    android:id="@+id/device_side_collapse"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="@string/device_side_collapse"
                    android:textColor="@color/qs_text_muted"
                    android:textSize="@dimen/qs_text_status" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/device_side_events"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp" />
                </ScrollView>

                <TextView
                    android:id="@+id/device_side_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/device_side_empty"
                    android:textColor="@color/qs_text_muted"
                    android:textSize="@dimen/qs_text_status"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
