<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 暗色设计令牌（PRD FR-16 设计系统）：
         全黑底 + 半透明白卡片 + 单一青色强调色。深色是为了值守场景下不刺眼，
         半透明白分层让黑底上的卡片有边界但不发灰，青色只用于“可操作/正常”状态。 -->
    <color name="qs_bg">#FF000000</color>
    <color name="qs_surface">#1AFFFFFF</color>
    <color name="qs_accent_soft">#3300BFA6</color>
    <color name="qs_accent">#FF00BFA6</color>
    <color name="qs_overlay">#99000000</color>
    <color name="qs_text">#FFFFFFFF</color>
    <color name="qs_text_muted">#99FFFFFF</color>
    <color name="qs_text_hint">#66FFFFFF</color>

    <!-- 设备状态色与 DeviceState 的优先级一一对应，避免各页面各写一套 -->
    <color name="qs_ok">#FF4CD964</color>
    <color name="qs_warn">#FFFFB74D</color>
    <color name="qs_danger">#FFFF5252</color>
    <color name="qs_idle">#FF9E9E9E</color>
    <!-- 启动图标背景：与品牌深底一致，自适应图标只暴露这一种颜色，避免各启动器取到白色 -->
    <color name="qs_icon_bg">#FF05100E</color>

    <!-- 设计令牌的唯一来源即上方 qs_* 一套（PRD FR-16 设计系统，T04776 / UI-01 收敛结论）：
         曾补的 qs_color_* 设计令牌经全仓检索 0 引用，已于本提交移除，避免双套并存造成取色歧义。
         主色 = qs_accent #FF00BFA6（青色，值守场景不刺眼）；如需改用更深的 #FF0F766E 备选色，
         属独立设计决策，不在本次机械收敛范围内。 -->
</resources>
