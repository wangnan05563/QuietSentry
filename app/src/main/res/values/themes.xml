<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- REQ-001 仅暗色：不能用 DayNight，它会跟随系统浅色模式把对话框等组件切浅色 -->
    <style name="Theme.QuietSentry" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- 页面进入/退出动效（PRD 4.6）：180ms 淡入上移 / 120ms 淡出，全局统一，
             各页面不再各自 overridePendingTransition -->
        <item name="android:windowAnimationStyle">@style/QsWindowAnim</item>
    </style>

    <style name="QsWindowAnim">
        <item name="android:windowEnterAnimation">@anim/fade_slide_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>
</resources>
