<?xml version="1.0" encoding="utf-8"?>
<!--
  摄像头端横屏（PRD §12.3：横屏时控件下移，避免遮挡画面中心）。
  这里的做法是把控件整体移出画面区：预览按 220dp 让出右侧，控件占这条侧栏，
  画面中心在任何时刻都不会被按钮盖住——底部叠加条在横屏下会吃掉近半屏，无法满足这一点。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="220dp" />

    <ScrollView
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#CC000000"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/qs_text_status" />

            <Button
                android:id="@+id/start_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/start_guard" />

            <Button
                android:id="@+id/stop_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/stop_guard" />

            <!-- 横屏曾是唯一漏掉连续记录的布局：MainActivity 对它无条件 setOnClickListener，
                 少了这个按钮会在 onCreate 直接 NPE 崩溃 -->
            <Button
                android:id="@+id/record_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/record_mode_entry" />

            <Button
                android:id="@+id/black_mode_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/black_mode_entry" />

            <Button
                android:id="@+id/timeline_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/timeline_entry" />

            <Button
                android:id="@+id/pairing_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pairing_entry" />

            <Button
                android:id="@+id/device_list_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/device_list_entry" />

            <Button
                android:id="@+id/remote_access_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/remote_entry" />

            <Button
                android:id="@+id/settings_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_entry" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
