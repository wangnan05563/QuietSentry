<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 黑屏拍照的震动确认（T04023）：普通权限，缺失时 vibrate 会静默失败，确认反馈形同虚设 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 局域网 HTTP 服务（ServerSocket）与观看端访问都需要网络能力；
         mDNS 走系统 NsdManager，本身只需要 INTERNET，不额外申请邻近设备权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 离线期间事件本地排队、恢复后补发摘要，需要读取当前网络状态 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 锁屏后未豁免的 UID 会被 ROM 冻结（Samsung Freecess），前台服务挡不住，需要引导用户加入白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- API 28 没有分区存储的 MediaStore 免权限写入，导出相册必须显式授权；29+ 一律不需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 重启后发“设备已重启”提醒：只读广播，不自动启动采集（PRD FR-13） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuietSentry"
        android:usesCleartextTraffic="true">

        <!-- 值守主界面不再锁竖屏：横屏用 layout-land 把控件移到画面右侧，平板与折叠屏才能真正被支持 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 首次功能介绍：可跳过，只出现一次；放在同意之后，不承担合法性披露职责 -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BlackScreenActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EventTimelineActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EventPlayerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 配对页负责颁发令牌，必须在值守与待机下都可用 -->
        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 观看端设备列表：局域网发现与状态轮询；宽屏双栏需要横竖屏都能切换。
             smallestScreenSize 变化（折叠屏折叠/展开）交由 Activity 自行判断：
             同断点内不重建以保住播放流，跨 840dp 断点才 recreate 换布局（T04058） -->
        <activity
            android:name=".DeviceListActivity"
            android:exported="false"
            android:configChanges="smallestScreenSize|screenSize" />

        <!-- 观看端扫码添加：解析配对二维码并直接握手，锁竖屏让取景框方向稳定 -->
        <activity
            android:name=".ScanPairActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 自组网引导与连通性诊断：只做证据收集，不建立任何隧道 -->
        <activity
            android:name=".RemoteAccessActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 实时画面允许随设备旋转，横屏时才能填满整块屏幕 -->
        <activity
            android:name=".LiveViewActivity"
            android:exported="false"
            android:screenOrientation="sensor" />

        <!-- 设置与诊断：免打扰、接收级别、健康面板与日志导出 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- 开机只发“设备已重启”提醒，不自动拉起相机（PRD FR-13）：
             后台静默启动采集会绕过用户确认，也容易在用户不在场时被系统二次回收 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
