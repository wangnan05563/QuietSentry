<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 局域网 HTTP 服务（ServerSocket）与观看端访问都需要网络能力；
         mDNS 走系统 NsdManager，本身只需要 INTERNET，不额外申请邻近设备权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 离线期间事件本地排队、恢复后补发摘要，需要读取当前网络状态 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 锁屏后未豁免的 UID 会被 ROM 冻结（Samsung Freecess），前台服务挡不住，需要引导用户加入白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- API 28 没有分区存储的 MediaStore 免权限写入，导出相册必须显式授权；29+ 一律不需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuietSentry"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BlackScreenActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EventTimelineActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EventPlayerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 配对页负责颁发令牌，必须在值守与待机下都可用 -->
        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 观看端设备列表：局域网发现与状态轮询 -->
        <activity
            android:name=".DeviceListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 自组网引导与连通性诊断：只做证据收集，不建立任何隧道 -->
        <activity
            android:name=".RemoteAccessActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

</manifest>
