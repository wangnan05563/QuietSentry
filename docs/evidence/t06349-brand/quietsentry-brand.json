{
  "name": "quietsentry",
  "label": "静哨 QuietSentry",
  "version": 1,
  "raw": {
    "bg": "#000000",
    "surface": "#1A1A1A",
    "accent": "#00BFA6",
    "accentSoft": "#002621",
    "text": "#FFFFFF",
    "textSecondary": "#DDDDDD",
    "textMuted": "#999999",
    "inkOnBrand": "#05100E",
    "line": "#383838",
    "lineStrong": "#535353",
    "ok": "#4CD964",
    "warn": "#FFB74D",
    "danger": "#FF5252",
    "idle": "#9E9E9E"
  },
  "semantic": {
    "brand": "raw.accent",
    "brand-ink": "raw.inkOnBrand",
    "brand-soft": "raw.accentSoft",
    "bg": "raw.bg",
    "surface": "raw.surface",
    "card": "raw.surface",
    "ink": "raw.text",
    "ink-2": "raw.textSecondary",
    "muted": "raw.textMuted",
    "line": "raw.line",
    "line-strong": "raw.lineStrong",
    "ff": "\"system-ui\",-apple-system,\"Segoe UI\",Roboto,\"Noto Sans SC\",sans-serif",
    "fs-2xs": "12sp",
    "fs-xs": "13sp",
    "fs-sm": "15sp",
    "fs-md": "18sp",
    "fs-lg": "20sp",
    "fs-xl": "24sp",
    "r-sm": "10dp",
    "r-md": "20dp",
    "r-full": "999dp",
    "shadow": "0 8px 24px rgba(0,0,0,.45),0 1px 2px rgba(0,0,0,.30)",
    "motion-fast": "150ms",
    "motion-base": "220ms",
    "motion-ease": "cubic-bezier(.2,0,0,1)"
