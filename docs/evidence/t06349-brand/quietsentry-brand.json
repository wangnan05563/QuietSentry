    "button.primary.radius": "semantic.r-sm",
    "button.primary.height": "48dp",
    "button.primary.padding-x": "16dp",
    "button.primary.font": "semantic.ff",
    "button.primary.font-size": "semantic.fs-sm",
    "button.primary.font-weight": "500",
    "badge.brand.background": "semantic.brand",
    "badge.brand.foreground": "semantic.brand-ink",
    "badge.brand.radius": "semantic.r-full",
    "badge.brand.height": "28dp",
    "badge.brand.padding-x": "8dp",
    "badge.brand.font-size": "semantic.fs-2xs",
    "badge.brand.font-weight": "600",
    "card.background": "semantic.card",
    "card.foreground": "semantic.ink",
    "card.secondary-foreground": "semantic.ink-2",
    "card.muted-foreground": "semantic.muted",
    "card.border": "semantic.line",
    "card.radius": "semantic.r-md",
    "card.padding": "16dp",
