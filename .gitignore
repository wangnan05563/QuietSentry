.gradle/
build/
local.properties
# 发布签名材料：只保留 example，真实密钥不进版本库
keystore.properties
*.jks
*.keystore
.idea/
*.iml
.screenshots/
# Kotlin 编译会话缓存（Gradle 8.x 在项目根生成）
.kotlin/
# 验证采样输出（CSV/日志/摘要），属于运行产物而非源码
verify-output/
# 可重建产物统一放这里：最终交付物在顶层，Gradle 中间产物 / 报告 / 项目缓存 / Scanner 工作目录在 .build/
# 整目录可删，下次构建自动重建
release/
# SonarScanner 旧工作目录（现已改到 release/.build/scannerwork，这里兜底历史残留）
.scannerwork/
# Python 字节码缓存（脚本自检时会生成）
__pycache__/
*.pyc

.trae
.workbuddy
.workbuddy-ai/
.env

# 散落的安卓构建/导出产物（release/ 目录已整体忽略，这里兜底）
*.apk
*.aab
*.hprof
hs_err_pid*.log
replay_pid*.log
.cxx/
.externalNativeBuild/
captures/

# 系统与编辑器临时文件
.DS_Store
Thumbs.db
